# Copy to .env for local runs (never commit .env). In CI these are set as
# GitHub Actions secrets/variables instead.

# --- LLM (analysis step). Without it, changes are flagged but not analyzed. ---
ANTHROPIC_API_KEY=
# Optional model override (default: claude-3-5-sonnet-latest)
LLM_MODEL=

# --- Email digest (notify step). Without these, the digest is only logged. ---
RESEND_API_KEY=
# Comma-separated list of recipients (start with the site owners).
DIGEST_RECIPIENTS=owner1@example.com,owner2@example.com
# Verified sender in your Resend account.
DIGEST_FROM=watchdog@nodatacenterahwatukee.org
# Public URL shown in the email footer.
SITE_PUBLIC_URL=https://nodatacenterahwatukee.org

# --- Scanner ---
# 2 = HTTP sources only (default). 5 = include headless-browser sources.
SCAN_PHASE=2
