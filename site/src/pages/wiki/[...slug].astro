---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const pages = await getCollection('wiki');
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

function hostname(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="prose" style="padding-top: 32px;">
    <a class="back-link" href={withBase('wiki')}>← Knowledge base</a>
    <h1 style="margin-top:4px;">{entry.data.title}</h1>
    {entry.data.updated && (
      <p style="color: var(--text-faint); font-size: 13px; margin-top: 0;">
        Last updated {entry.data.updated}
      </p>
    )}

    <Content />

    {entry.data.sources && entry.data.sources.length > 0 && (
      <div class="sources">
        <strong>Sources</strong>
        <ul>
          {entry.data.sources.map((s) => (
            <li><a href={s} target="_blank" rel="noopener">{hostname(s)} — {s}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Base>
