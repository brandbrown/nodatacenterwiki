---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import { loadTimeline, progress, openCommunityActions, STATUS_LEGEND } from '../lib/timeline';
import { loadChangelog } from '../lib/changelog';
import { withBase } from '../lib/url';

const timeline = loadTimeline();
const { done, total, pct } = progress(timeline);
const p = timeline.project;
const latest = loadChangelog().slice(0, 3);
const actions = openCommunityActions(timeline);
const remaining = timeline.stages.filter((s) => s.status !== 'done').length;

function fmtDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch {
    return iso;
  }
}
---

<Base title="home" description={p.summary}>
  <section class="hero">
    <h1>{p.name}</h1>
    <div class="meta">{p.address} · City case {p.case}</div>
    <p class="summary">{p.summary}</p>

    <div class="factbar">
      <span><b>Developer:</b> {p.developer}</span>
      <span><b>Scale:</b> {p.scale}</span>
      {p.developer_targets && <span><b>Developer targets:</b> {p.developer_targets}</span>}
    </div>

    <div class="progress-wrap">
      <div class="progress-head">
        <span class="label">Checkpoints the developer has cleared</span>
        <span class="pct">{done} of {total} ({pct}%)</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width:${pct}%`}></div>
      </div>
      <p class="progress-note">
        {remaining} stages are still open. Green is complete. Yellow is in city review.
        Red is denied or stalled. Gray has not been reached yet.
      </p>
      <div class="legend">
        {STATUS_LEGEND.map((item) => (
          <span class={`badge ${item.status}`}>{item.label}</span>
        ))}
      </div>
    </div>
  </section>

  {actions.length > 0 && (
    <section class="involve-section">
      <h2 class="section-title">Where the community can get involved</h2>
      <p class="section-sub">
        These are resident actions at stages that are still open — records requests, comments,
        documentation, and asking officials questions. Legal strategy stays with the Alliance
        and its attorney and is not listed here.
      </p>
      <div class="involve-grid">
        {actions.map(({ stage, action }) => (
          <a class={`involve-card${action.priority === 'high' ? ' high' : ''}`} href={`#${stage.id}`}>
            <div class="involve-stage">{stage.title}</div>
            <strong>{action.title}</strong>
            <p>{action.how}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section>
      <h2 class="section-title">Latest developments</h2>
      <p class="section-sub">
        Auto-detected changes from official sources and news.
        <a href={withBase('changelog')}> See all →</a>
      </p>
      <div class="change-list">
        {latest.map((c) => (
          <div class="change">
            <div class="date">{fmtDate(c.date)} · {c.source}</div>
            <h3>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.title}</a> : c.title}</h3>
            <p>{c.summary}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="section-title">Project timeline</h2>
    <p class="section-sub">
      Every approval this project still has to clear, in order. Under open stages, look for
      <b>Community involvement</b> — concrete things neighbors can do at that checkpoint.
    </p>
    <div class="timeline">
      {timeline.stages.map((stage) => <Stage stage={stage} />)}
    </div>
  </section>

  <div class="notice">
    This is a volunteer watchdog tool. Status reflects public records and news as of
    {' '}{fmtDate(p.last_updated)}. Always verify time-sensitive items (like permit comment
    windows) against the official source before acting. Nothing on this site is legal advice.
  </div>
</Base>
